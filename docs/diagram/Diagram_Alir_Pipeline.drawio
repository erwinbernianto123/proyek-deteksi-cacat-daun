<mxfile host="app.diagrams.net"><diagram id="pipeline" name="Pipeline deteksi cacat daun"><mxGraphModel dx="1000" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="830" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="in" value="Citra masukan (BGR)" style="html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=12;rounded=1;arcSize=50;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="120" y="20" width="400" height="36" as="geometry"/></mxCell><mxCell id="t1" value="&lt;b&gt;Tahap 1. Pra-proses&lt;/b&gt;&lt;br&gt;Resize (sisi terpanjang maks. 1024 px)&lt;br&gt;Filter Gaussian atau median (kernel 5×5)" style="html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=12;rounded=0;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="120" y="78" width="400" height="65" as="geometry"/></mxCell><mxCell id="t2" value="&lt;b&gt;Tahap 2. Perbaikan kontras&lt;/b&gt;&lt;br&gt;Konversi BGR ke Lab, CLAHE pada kanal L&lt;br&gt;(clip limit 2,0; grid 8×8), lalu kembali ke BGR" style="html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=12;rounded=0;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="120" y="165" width="400" height="65" as="geometry"/></mxCell><mxCell id="t3a" value="&lt;b&gt;Tahap 3a. Mask daun: kandidat dan seleksi&lt;/b&gt;&lt;br&gt;Otsu pada Saturation, Saturation terbalik, V terbalik, a*&lt;br&gt;Opening 5×5, closing 7×7, hole filling&lt;br&gt;Pilih komponen dengan skor terbaik (luas, solidity,&lt;br&gt;posisi, tepi Sobel, porsi hijau)" style="html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=12;rounded=0;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="120" y="252" width="400" height="99" as="geometry"/></mxCell><mxCell id="dec" value="Skor komponen&lt;br&gt;≥ ambang (1000)?" style="html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=12;rhombus;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="200.0" y="373" width="240" height="78" as="geometry"/></mxCell><mxCell id="fb" value="&lt;b&gt;Kandidat cadangan&lt;/b&gt;&lt;br&gt;Otsu pada jarak warna dari latar;&lt;br&gt;dipakai bila skornya lebih tinggi" style="html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=12;rounded=0;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="560" y="380" width="250" height="65" as="geometry"/></mxCell><mxCell id="hole" value="&lt;b&gt;Hole filling (flood fill) dan convex hull&lt;/b&gt;&lt;br&gt;menghasilkan mask daun (0/255)" style="html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=12;rounded=0;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="120" y="473" width="400" height="48" as="geometry"/></mxCell><mxCell id="t3b1" value="&lt;b&gt;Tahap 3b. Fitur cacat per piksel&lt;/b&gt;&lt;br&gt;Kanal hue (HSV) citra hasil CLAHE" style="html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=12;rounded=0;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="120" y="543" width="400" height="48" as="geometry"/></mxCell><mxCell id="t3b2" value="&lt;b&gt;Ambang dan mask cacat mentah&lt;/b&gt;&lt;br&gt;Area cari = mask daun dikikis (2 px)&lt;br&gt;Cacat bila hue &amp;lt; 30 (ambang tetap)" style="html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=12;rounded=0;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="120" y="613" width="400" height="65" as="geometry"/></mxCell><mxCell id="t4" value="&lt;b&gt;Tahap 4. Morfologi&lt;/b&gt;&lt;br&gt;Opening 3×3, lalu closing 5×5 (elemen penstruktur elips)&lt;br&gt;Buang komponen cacat &amp;lt; 300 piksel" style="html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=12;rounded=0;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="120" y="700" width="400" height="65" as="geometry"/></mxCell><mxCell id="t5" value="&lt;b&gt;Tahap 5. Pengukuran&lt;/b&gt;&lt;br&gt;Connected components: bounding box tiap cacat&lt;br&gt;Luas cacat (piksel) dan rasio luas cacat/daun" style="html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=12;rounded=0;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="120" y="787" width="400" height="65" as="geometry"/></mxCell><mxCell id="out" value="Keluaran: mask cacat biner (0/255), bounding box, luas" style="html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=12;rounded=1;arcSize=50;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="120" y="874" width="400" height="36" as="geometry"/></mxCell><mxCell id="ev" value="&lt;b&gt;Evaluasi&lt;/b&gt;&lt;br&gt;IoU, Dice, precision, recall" style="html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=12;rounded=0;fillColor=#FFFFFF;strokeColor=#000000;dashed=1;" vertex="1" parent="1"><mxGeometry x="120" y="932" width="400" height="48" as="geometry"/></mxCell><mxCell id="gt" value="Mask ground truth&lt;br&gt;(data/masks)" style="html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=12;shape=parallelogram;perimeter=parallelogramPerimeter;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="560" y="932" width="250" height="48" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#000000;fontFamily=Times New Roman;fontSize=12;" edge="1" parent="1" source="in" target="t1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#000000;fontFamily=Times New Roman;fontSize=12;" edge="1" parent="1" source="t1" target="t2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#000000;fontFamily=Times New Roman;fontSize=12;" edge="1" parent="1" source="t2" target="t3a"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#000000;fontFamily=Times New Roman;fontSize=12;" edge="1" parent="1" source="t3a" target="dec"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="Ya" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#000000;fontFamily=Times New Roman;fontSize=12;" edge="1" parent="1" source="dec" target="hole"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="Tidak" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#000000;fontFamily=Times New Roman;fontSize=12;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="dec" target="fb"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#000000;fontFamily=Times New Roman;fontSize=12;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="fb" target="hole"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#000000;fontFamily=Times New Roman;fontSize=12;" edge="1" parent="1" source="hole" target="t3b1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#000000;fontFamily=Times New Roman;fontSize=12;" edge="1" parent="1" source="t3b1" target="t3b2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#000000;fontFamily=Times New Roman;fontSize=12;" edge="1" parent="1" source="t3b2" target="t4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#000000;fontFamily=Times New Roman;fontSize=12;" edge="1" parent="1" source="t4" target="t5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#000000;fontFamily=Times New Roman;fontSize=12;" edge="1" parent="1" source="t5" target="out"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#000000;fontFamily=Times New Roman;fontSize=12;" edge="1" parent="1" source="out" target="ev"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#000000;fontFamily=Times New Roman;fontSize=12;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="gt" target="ev"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>